# Copy to .env for local dev, OR set these as Environment Variables in CylonCloud deploy panel

# -----------------------------------------------------------------------
# CylonCloud gives you a connectionString like:
#   mysql://USER:PASS@HOST:3306/DBNAME
#
# Convert it to JDBC format for DB_URL:
#   jdbc:mysql://HOST:3306/DBNAME
#
# DO NOT copy the connectionString directly — it will not work.
# -----------------------------------------------------------------------
DB_URL=jdbc:mysql://YOUR_HOST:3306/YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# App settings
PORT=8080
APP_NAME=EcommerceApp

# Set this to your deployed React frontend URL when deploying to cloud
# e.g. https://your-react-app.cyloncloud.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
