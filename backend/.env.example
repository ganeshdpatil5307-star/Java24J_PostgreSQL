# Copy to .env for local dev, OR set these as Environment Variables in your deploy panel

# -----------------------------------------------------------------------
# Your PostgreSQL provider gives you a connection string like:
#   postgresql://USER:PASS@HOST:5432/DBNAME
#
# Convert it to JDBC format for DB_URL:
#   jdbc:postgresql://HOST:5432/DBNAME
#
# DO NOT copy the raw connection string directly - it will not work.
# -----------------------------------------------------------------------
DB_URL=jdbc:postgresql://YOUR_HOST:5432/YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD

# App settings
PORT=8080
APP_NAME=EcommerceApp

# Set this to your deployed React frontend URL when deploying to cloud
# e.g. https://your-react-app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:5173
